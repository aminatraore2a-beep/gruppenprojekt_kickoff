// prisma/schema.prisma
// Aufgabe 9.3: Modelle für Buchungssystem

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Room {
  id          Int       @id @default(autoincrement())
  name        String
  capacity    Int
  description String?
  equipment   String?
  bookings    Booking[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id          Int       @id @default(autoincrement())
  roomId      Int
  room        Room      @relation(fields: [roomId], references: [id])

  bookerName  String
  bookerEmail String

  startTime   DateTime
  endTime     DateTime

  purpose     String
  status      BookingStatus @default(CONFIRMED)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}